{application, gakudan_tickets_github, [
    {description, "GitHub Issues adapter for gakudan_tickets"},
    {vsn, "git"},
    {registered, [gakudan_tickets_github_sup, gakudan_tickets_github_token_cache]},
    {mod, {gakudan_tickets_github_app, []}},
    {applications, [kernel, stdlib, crypto, inets, ssl, public_key, gakudan_tickets]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/Taure/gakudan_tickets_github"}]}
]}.
